# LLM backend configuration
HOME_AI_LLM_BACKEND=gemini
HOME_AI_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-api-key
GOOGLE_API_KEY=
OPENAI_API_KEY=

# TTS backend configuration
