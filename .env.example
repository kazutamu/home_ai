HOME_AI_TTS_MODEL=tts_models/en/vctk/vits
HOME_AI_TTS_GOOGLE_LANGUAGE=en-US
HOME_AI_TTS_GOOGLE_VOICE=
HOME_AI_TTS_GOOGLE_SAMPLE_RATE=24000
GOOGLE_APPLICATION_CREDENTIALS=

# Audio backend configuration
HOME_AI_AUDIO_BACKEND=ffplay
